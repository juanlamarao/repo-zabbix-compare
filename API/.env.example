# Banco do próprio validador
POSTGRES_DB=zuv
POSTGRES_USER=zuv
POSTGRES_PASSWORD=troque-esta-senha
PORT=8080

# APIs. Use o caminho completo até api_jsonrpc.php.
OLD_ZABBIX_URL=https://zabbix6.exemplo.local/zabbix/api_jsonrpc.php
OLD_ZABBIX_TOKEN=TOKEN_ZABBIX_6
NEW_ZABBIX_URL=https://zabbix7.exemplo.local/zabbix/api_jsonrpc.php
NEW_ZABBIX_TOKEN=TOKEN_ZABBIX_7

# false somente se você realmente usa certificado interno/não confiável.
VERIFY_SSL=true
REQUEST_TIMEOUT_SECONDS=90
API_RETRIES=3

# Estratégia inicial combinada: 5 hosts por lote e 5 lotes paralelos.
HOSTS_PER_BATCH=5
PARALLEL_BATCHES=5
COLLECTION_INTERVAL_SECONDS=300
ACTION_ALERT_SCAN_LIMIT=100
